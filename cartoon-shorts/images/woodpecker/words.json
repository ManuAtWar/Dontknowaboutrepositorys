 "sentences": [
  {
   "text": "Why don't woodpeckers get concussions?",
   "s": 0.14,
   "e": 2.26
  },
  {
   "text": "The popular answer was a shock-absorbing skull.",
   "s": 2.84,
   "e": 5.38
  },
  {
   "text": "But high-speed video showed the opposite.",
   "s": 5.78,
   "e": 7.8
  },
  {
   "text": "The head doesn't cushion the hit.",
   "s": 8.28,
   "e": 9.48
  },
  {
   "text": "It stops as suddenly as the beak, like a stiff hammer.",
   "s": 9.76,
   "e": 12.52
  },
  {
   "text": "Cushioning would weaken every peck.",
   "s": 13.12,
   "e": 14.72
  },
  {
   "text": "The real protection is size.",
   "s": 15.24,
   "e": 16.72
  },
  {
   "text": "A woodpecker's brain is so small and light that it can handle stops that would concuss a human.",
   "s": 17.24,
   "e": 21.96
  }
 ],
